{
  "name": "@vdisplay/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pack": "electron-builder build --win portable"
  },

  "main": "dist/main.cjs",

  "build": {
    "appId": "com.precisionplanit.vdisplay",
    "asar": true,

    "files": ["bin/**", "dist/**", "package.json"],

    "extraResources": [
      { "from": "../web/dist", "to": "ui" },
      { "from": "bin", "to": "bin" },
      { "from": "assets/icons", "to": "icons" }
    ],

    "directories": { "output": "release" },

    "win": {
      "target": "portable",
      "artifactName": "VDisplay-Wizard-${version}-win-${arch}.${ext}",
      "icon": "assets/icons/app.ico"
    }
  },

  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}