{
    "name": "@vdisplay/desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
      "dev": "vite",
      "build": "vite build",
      "postinstall": "electron-builder install-app-deps --electron-version=31.7.7"
    },
    "build": {
      "appId": "com.precisionplanit.vdisplay",
      "asar": true,
      "files": [
        "dist/**"
      ],
      "extraResources": [
        { "from": "../web/dist", "to": "ui" }
      ],
      "win": {
        "target": "portable",
        "artifactName": "VDisplay-Wizard-${version}-win-${arch}.${ext}"
      },
      "electronVersion": "31.7.7"
    },
    "devDependencies": {
      "electron": "31.7.7",
      "electron-builder": "^24.13.3",
      "typescript": "^5.6.2",
      "vite": "^5.4.1"
    },
    "dependencies": {}
  }