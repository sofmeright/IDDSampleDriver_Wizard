{
    "name": "@vdisplay/desktop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
      "dev": "vite",
      "build": "vite build",
      "pack:win": "electron-builder --win portable",
      "postinstall": "electron-builder install-app-deps"
    },
    "build": {
      "appId": "com.precisionplanit.vdisplay",
      "asar": true,
      "files": [
        "dist/**"
      ],
      "extraResources": [
        { "from": "../web/dist", "to": "ui" }
      ],
      "win": {
        "target": "portable", // single .exe
        "artifactName": "VDisplay-Wizard-${version}-win-${arch}.${ext}"
      }
    }
  }