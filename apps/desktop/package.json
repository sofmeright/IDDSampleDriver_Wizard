{
  "//": "// apps/desktop/package.json",
  "build": {
    "appId": "com.precisionplanit.vdisplay",
    "asar": true,
    "files": ["dist/**", "package.json"],
    "extraResources": [{ "from": "../web/dist", "to": "ui" }],
    "directories": { "output": "release" },
    "win": {
      "target": "portable",
      "artifactName": "VDisplay-Wizard-${version}-win-${arch}.${ext}"
    },
    "electronVersion": "31.7.7"
  },
  "main": "dist/main.cjs"
}